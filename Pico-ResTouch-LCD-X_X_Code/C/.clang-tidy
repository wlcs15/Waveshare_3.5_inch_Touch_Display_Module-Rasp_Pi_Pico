---
# Host gate: lib/quality + tests only.
# Do not scan vendor lib/lcd, lib/fatfs, lib/font (Waveshare/ST).
# google-* / cert-* are C++/CERT style; they drown C+Unity reports.
Checks: 'clang-diagnostic-*,clang-analyzer-*'
WarningsAsErrors: 'clang-diagnostic-error,clang-analyzer-*'
HeaderFilterRegex: 'lib/quality/|tests/'
FormatStyle: none
